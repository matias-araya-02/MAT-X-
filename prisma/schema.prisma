generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Categoria {
  id             String     @id @default(cuid())
  nombre         String
  slug           String     @unique
  descripcion    String?
  imagenUrl      String?
  imagenPublicId String?
  imagenEscala   Int        @default(70)
  orden          Int        @default(0)
  productos      Producto[]
}

model Marca {
  id           String     @id @default(cuid())
  nombre       String     @unique
  slug         String     @unique
  logoUrl      String?
  logoPublicId String?
  logoEscala   Int        @default(80)
  createdAt    DateTime   @default(now())
  productos    Producto[]
}

model Producto {
  id          String     @id @default(cuid())
  nombre      String
  slug        String     @unique
  // TEMPORAL: columna vieja "marca" (texto libre). Se elimina en el paso 7.
  marcaTexto  String?    @map("marca")
  marca       Marca?     @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  marcaId     String?
  sku         String?    @unique
  descripcion String?
  precio      Int
  descuento   Int?
  stock       Int        @default(0)
  activo      Boolean    @default(true)
  destacado   Boolean    @default(false)
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  categoriaId String
  imagenes       Imagen[]
  variantes      Variante[]
  destacadosHome DestacadoHome[]
  heroSlides     HeroSlide[]
  createdAt      DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoriaId])
  @@index([marcaId])
  @@index([activo, destacado])
}

model Variante {
  id         String   @id @default(cuid())
  nombre     String
  precio     Int?
  stock      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId String

  @@index([productoId])
}

model Imagen {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  alt        String?
  orden      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId String

  @@index([productoId])
}

model Pedido {
  id            String       @id @default(cuid())
  numero        Int          @unique @default(autoincrement())
  codigo        String       @unique @default(cuid())
  items         Json
  total         Int
  estado        EstadoPedido @default(CONSULTA)
  nombreCliente String?
  telefono      String?
  notas         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([estado])
  @@index([createdAt])
}

model Config {
  id                     Int @id @default(1)
  descuentoTransferencia Int @default(0)
}

model BannerParallax {
  id             Int     @id @default(1)
  activo         Boolean @default(false)
  imagenUrl      String?
  imagenPublicId String?
  overlay        Int     @default(40)
  altura         Int     @default(480)
  intensidad     Int     @default(60)
  anchoCompleto  Boolean @default(true)
  titulo         String?
  subtitulo      String?
  botonTexto     String?
  botonUrl       String?
}

model DestacadoHome {
  id             String   @id @default(cuid())
  orden          Int      @unique // 0, 1, 2: posición en la home
  imagenUrl      String
  imagenPublicId String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId     String
  createdAt      DateTime @default(now())

  @@index([productoId])
}

model HeroSlide {
  id             String   @id @default(cuid())
  orden          Int      @default(0)
  activo         Boolean  @default(true)
  palabra        String? // palabra gigante de fondo; si es null se usa el nombre del producto
  imagenUrl      String
  imagenPublicId String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId     String
  createdAt      DateTime @default(now())

  @@index([productoId])
  @@index([orden])
}

enum EstadoPedido {
  CONSULTA
  CONFIRMADO
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}
